# Bangi Car Rental: environment variables (names and explanations only; never commit real values).
#
# BUILD TIME: none. The Docker image is built without any of these.
# RUNTIME:    all of them. Set them in Coolify > Application > Environment Variables
#             (leave "Build Variable" unticked). Locally, copy this file to .env.local.

# Public address of the site, no trailing slash. Used for Stripe return URLs and email links.
# Production: https://bangicarrental.my   Local: http://localhost:3000
APP_URL=

# --- Supabase (dedicated Bangi Car Rental project) -------------------------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Publishable / anon key. Used server-side with the visitor session; Row Level Security applies.
SUPABASE_ANON_KEY=
# SECRET. Service-role key: bypasses Row Level Security. Server only; never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ----------------------------------------------------------------------------------
# SECRET. sk_test_... for test mode, sk_live_... for real payments.
# With a live key, checkout stays closed until the admin launch checklist is complete
# and "Enable live payments" is switched on in Admin > Settings.
STRIPE_SECRET_KEY=
# SECRET. Signing secret (whsec_...) of the webhook endpoint https://<domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) --------------------------------------------------------------------------
# SECRET. Resend API key. Without it, emails wait in the outbox and are retried later.
RESEND_API_KEY=
# Fallback sender if Admin > Settings > "Email from" is empty,
# e.g. Bangi Car Rental <tempahan@bangicarrental.my>
EMAIL_FROM=
# Fallback address for operator alerts if Admin > Settings > "Admin alert email" is empty.
ADMIN_ALERT_EMAIL=
# Optional, development only: set to "log" to print email subjects instead of sending.
EMAIL_DELIVERY=

# --- Scheduled tasks -------------------------------------------------------------------------
# SECRET. Long random string (at least 16 characters, e.g. `openssl rand -hex 32`).
# The Coolify scheduled task sends it as "Authorization: Bearer <value>" to /api/cron/tick.
CRON_SECRET=
